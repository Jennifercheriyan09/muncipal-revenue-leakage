APP_NAME="Municipal Revenue Leakage Intelligence System"
APP_ENV=development
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY= 
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=municipal
POSTGRES_PASSWORD=municipal
POSTGRES_DB=municipal_revenue
DATABASE_URL=postgresql+asyncpg://municipal:municipal@postgres:5432/municipal_revenue

REDIS_URL=redis://redis:6379/0
# Set a strong password for production. Leave empty for local development only.
REDIS_PASSWORD=

QDRANT_URL=http://qdrant:6333
# Set a strong API key for production. Leave empty for local development only.
QDRANT_API_KEY=

OLLAMA_BASE_URL=http://ollama:11434

# Groq LLM — powers evidence_summary_agent narrative generation
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
